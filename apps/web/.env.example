# Vercel / ローカルビルド用: デプロイ済み Worker のオリジン（末尾スラッシュなし）。LIFF /auth/line リンクにも使う。
NEXT_PUBLIC_API_URL=https://YOUR_SUBDOMAIN.workers.dev

# 任意: ブラウザの fetch だけ別ベース（同一オリジンの Access プロキシ `/api/lh-upstream` など）。未設定時は NEXT_PUBLIC_API_URL と同じ。
# NEXT_PUBLIC_ADMIN_BROWSER_API_BASE=https://YOUR_ADMIN_HOST/api/lh-upstream

# Worker で Cloudflare Access 必須のとき: ログインは {} のみ送信（同一オリジンで JWT/Cookie が付く構成にする）
# NEXT_PUBLIC_USE_CLOUDFLARE_ACCESS_LOGIN=1
